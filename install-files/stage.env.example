# Copia a /etc/eduhoot/stage.env y adapta valores
# chmod 640 /etc/eduhoot/stage.env

NODE_ENV=staging
PORT=3100

# Recomendado aislar también la BBDD de stage
MONGO_URL=mongodb://127.0.0.1:27017/eduhoot_stage
MONGO_MAX_POOL_SIZE=20

# URL pública del entorno stage
PUBLIC_BASE_URL=https://stage.tu-dominio

# OAuth opcional para stage
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://stage.tu-dominio/api/auth/google/callback
